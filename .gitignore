# Entornos virtuales de Python
venv/
env/
ENV/
.venv/

# Archivos compilados y temporales de Python
__pycache__/
*.py[cod]
*$py.class
*.log

# Carpetas de compilacion del ejecutable (PyInstaller)
build/
dist/
*.spec

# Archivos y carpetas temporales de pruebas / scratch
scratch/

# Documentos generados y proteccion de datos personales (padron, expedientes, etc.)
Informes_Generados/*
!Informes_Generados/.gitkeep
Informes_Generados_Backup/
*.pdf
*.docx
*.xlsx
*.xls
*.csv

# Excepciones obligatorias: Plantillas maestras del sistema
!plantillas/*.docx
!plantillas/*.xlsx

# Archivos de respaldo temporales
*_backup.*
*_backup_*.*
*_patch.*

# Archivos de configuracion local de IDE
GEMINI.md
.geminiignore
.antigravityignore
