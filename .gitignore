# Archivos temporales de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
env/
ENV/

# Carpetas de compilación del ejecutable (PyInstaller)
build/
dist/
*.spec
!main.spec

# Documentos generados y pruebas (No subir datos sensibles)
Informes_Generados/
Informes_Generados_Backup/
Pruebas/
datos_sensibles/
output/
*.pdf
*.docx
*.xlsx
*.xls
*.csv
*.db
*.sqlite
*.sqlite3
*.log
error_log.txt

# Excepciones (Plantillas oficiales requeridas)
!plantillas/*.docx
!plantillas/*.xlsx
!plantillas/*.xls
!plantillas/*.bak

# Configuraciones de editor y asistente local
.vscode/
.idea/
.agents/
.antigravityignore
.geminiignore
GEMINI.md

